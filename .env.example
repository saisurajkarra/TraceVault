# Copy to .env and adjust. All settings are env-driven (config.py reads these).
# These defaults match docker-compose.yml so the system works out of the box locally.

# --- MinIO / S3 ---
TRACEVAULT_MINIO_ENDPOINT=http://localhost:9000
TRACEVAULT_MINIO_ACCESS_KEY=minioadmin
TRACEVAULT_MINIO_SECRET_KEY=minioadmin
TRACEVAULT_MINIO_REGION=us-east-1
# Single bucket holds BOTH raw blobs and the Iceberg warehouse.
TRACEVAULT_BUCKET=tracevault

# --- Local state (sqlite catalog db + LanceDB dir live on the local disk;
#     the Iceberg DATA itself lives in MinIO) ---
TRACEVAULT_DATA_DIR=./data

# --- Embeddings (real, local, offline) ---
TRACEVAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- API ---
TRACEVAULT_API_HOST=127.0.0.1
TRACEVAULT_API_PORT=8000

# --- Optional: grounded natural-language answers via the Anthropic API.
#     If unset, /ask returns the real retrieved context with a clear note and
#     NEVER fabricates an answer. ---
# ANTHROPIC_API_KEY=sk-ant-...
